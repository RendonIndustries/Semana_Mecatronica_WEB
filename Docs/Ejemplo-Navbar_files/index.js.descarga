            case 2 > b: document.getElementById("blockD").style.display = "block";
                document.getElementById("send").style.display = "block";
                selectInfo = 4;
                break;
            case 2 <= b: document.getElementById("blockD").style.display = "block";
                document.getElementById("Coment").style.display =
                    "block";
                document.getElementById("send").style.display = "block";
                selectInfo = 1;
                break;
            default: alert("Selecciona una opci\u00f3n")
        }
        else alert("Selecciona una opci\u00f3n"), valor = 0;
        if (1 == a) switch (console.log(b), !0) {
            case 1 == b: case 2 == b: case 5 == b: textoInfo = "Direcci\u00f3n de Egresados y Servicio Social";
                break;
            case 3 == b: case 4 == b: textoInfo = "Coordinaci\u00f3n de Cooperaci\u00f3n acad\u00e9mica";
                break;
            case 9 == b: case 7 == b: case 8 == b: textoInfo = "Direcci\u00f3n de Administraci\u00f3n Escolar";
                break;

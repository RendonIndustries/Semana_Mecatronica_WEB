// FORMULARIO BUZON
$("#frmContactoBuzon").submit(function () {
    event.preventDefault();
    var a = {
        nombre: $("#frmContactoBuzon #nombre").val(),
        correo: $("#frmContactoBuzon #correo").val(),
        perfil: $("#frmContactoBuzon #perfil").val(),
        area: $("#frmContactoBuzon #area").val(),
        mensaje: $("#frmContactoBuzon #mensaje").val()
    };
    
    console.log(a);

    $.ajax({
        type: "POST", url: "//www.cpwi-buzon404.ipn.mx/Modx/buzon/mail-v2.php", data: a, success: function () {
            $("#frmContactoBuzon .alert").slideDown("slow", function () {
                setTimeout(function () {
                    $(".alert").slideUp("slow");
                    resetFrmContactoBuzon();
                },
                    2500)
            })
        },
        error: function (a, c, d) {
            resetFrmContactoBuzon();
            console.log(a, c, d);
        }
    });
    return !1
});

function resetFrmContactoBuzon(){
    $("#frmContactoBuzon").find(".form-control").val("");
    $("#perfil option[value='0']").prop("selected", true);
    $("#area option[value='0']").prop("selected", true); 
}


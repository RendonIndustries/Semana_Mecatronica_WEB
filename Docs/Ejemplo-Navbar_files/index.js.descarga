function cargarSelect(a) {
    var b = [[1, 1, "Servicio Social"], [1, 2, "Bolsa de trabajo para egresados"], [1, 3, "Movilidad Acad\u00e9mica: Nacional e Internacional"], [1, 4, "Convenios de Colaboraci\u00f3n Acad\u00e9mica"], [1, 5, "Bolsa de trabajo"], [1, 6, "Orientaci\u00f3n juvenil"], [1, 7, "Gesti\u00f3n de tr\u00e1mites"], [1, 8, "Cambio de Modalidad escolarizada a Modalidad mixta"], [1, 9, "Seguimiento de tr\u00e1mite de t\u00edtulo, certifiado, carta de pasante y cedula profesional"], [1, 10, "Otro"], [2, 1, "Proceso de admisi\u00f3n"],
    [2, 2, "Convocatorias"], [2, 3, "Educacion virtual"], [2, 4, "Dudas espec\u00edficas"], [3, 1, "Internacional"], [3, 2, "Registro de empresas para bolsa de trabajo"], [3, 3, "Empresas solicitantes de alumnos para Servicio Social"], [3, 4, "Informaci\u00f3n relacionada a comunicados"], [3, 5, "Registro de empresas para proveedores"], [3, 6, "Otro"], [4, 1, "Movilidad Acad\u00e9mica: Nacional e Internacional"], [4, 2, "A\u00f1o sab\u00e1tico"], [4, 3, "Otro"], [5, 1, "Prestaciones y servicios capital humano"], [5, 2, "Tr\u00e1mites capital humano"],
    [5, 3, "Correo electr\u00f3nico"], [5, 4, "Otro"]];
    if (0 == a) document.getElementById("select2").value = "0", document.getElementById("select2").disabled = !0, document.getElementById("blockD").style.display = "none", document.getElementById("Coment").style.display = "none", document.getElementById("send").style.display = "none";
    else {
        document.getElementById("select2").options.length = 0;
        document.getElementById("blockD").style.display = "none";
        document.getElementById("Coment").style.display = "none";
        document.getElementById("send").style.display =
            "none";
        document.getElementById("select2").options[0] = new Option("Selecciona una opci\u00f3n", "0");
        for (i = 0;
            i < b.length;
            i++)b[i][0] == a && (document.getElementById("select2").options[document.getElementById("select2").options.length] = new Option(b[i][2], b[i][1]));
        document.getElementById("select2").disabled = !1
    }
}
function seleccinado_select2(a) {
    a = document.getElementById("select1");
    a = a.options[a.selectedIndex].value;
    var b = document.getElementById("select2");
    b = b.options[b.selectedIndex].value;
    document.getElementById("blockD").style.display = "none";
    document.getElementById("Coment").style.display = "none";
    document.getElementById("send").style.display = "none";
    if (0 != b || 0 != a) {
        if (1 == a) switch (!0) {
            case 7 > b || 10 == b: document.getElementById("blockD").style.display = "block";
                document.getElementById("Coment").style.display = "block";
                document.getElementById("send").style.display = "block";
                selectInfo = 1;
                break;
            case 7 <= b && 10 > b: document.getElementById("send").style.display = "block";
                selectInfo = 2;
                url = 9 == b ? "https://www.sicert.ipn.mx/" : "http://www.dae.ipn.mx/buzon/";
                break;
            default: alert("Selecciona una opci\u00f3n")
        }
        else if (2 == a) switch (!0) {
            case 1 == b: document.getElementById("send").style.display = "block";
                selectInfo = 2;
                url = "https://www.admision.ipn.mx/portal/ingreso.html";
                break;
            case 2 == b: document.getElementById("send").style.display = "block";
                selectInfo =
                    2;
                url = "https://www.admision.ipn.mx/";
                break;
            case 3 == b: document.getElementById("send").style.display = "block";
                selectInfo = 2;
                url = "http://www.ipn.mx/ofertaeducativa/Paginas/educacion-virtual.aspx";
                break;
            case 4 == b: document.getElementById("send").style.display = "block";
                selectInfo = 2;
                url = "http://www.dae.ipn.mx/buzon/";
                break;
            default: alert("Selecciona una opci\u00f3n")
        }
        else if (3 == a) switch (!0) {
            case 4 > b || 6 == b: document.getElementById("blockD").style.display = "block";
                document.getElementById("Coment").style.display =
                    "block";
                document.getElementById("send").style.display = "block";
                selectInfo = 1;
                break;
            case 4 == b: document.getElementById("send").style.display = "block";
                url = "http://www.ipn.mx";

    }
    document.getElementById("blockD").style.display = "none";
    document.getElementById("Coment").style.display = "none";
    document.getElementById("send").style.display = "none"
}

    
//Efecto count para Numeraria  
(function($) {
    $.fn.countTo = function(options) {
      return this.each(function() {
        //-- Arrange
        var FRAME_RATE = 60; // Predefine default frame rate to be 60fps
        var $el = $(this);
        var countFrom = parseInt($el.attr('data-count-from'));
        var countTo = parseInt($el.attr('data-count-to'));
        var countSpeed = $el.attr('data-count-speed'); // Number increment per second
  
        //-- Action
        var rafId;
        var increment;
        var currentCount = countFrom;
        var countAction = function() {              // Self looping local function via requestAnimationFrame
          if(currentCount < countTo) {              // Perform number incremeant
            $el.text(Math.floor(currentCount));     // Update HTML display
            increment = countSpeed / FRAME_RATE;    // Calculate increment step
            currentCount += increment;              // Increment counter
            rafId = requestAnimationFrame(countAction);
          } else {                                  // Terminate animation once it reaches the target count number
            $el.text(countTo);                      // Set to the final value before everything stops
            //cancelAnimationFrame(rafId);
          }
        };
        rafId = requestAnimationFrame(countAction); // Initiates the looping function
      });
    };
  }(jQuery));
  $('.number-counter').countTo();
  
// SCRIPT PARA BUSCADOR GRATUITO DE GOOGLE
function enviarBusqueda(){
    var texto = document.getElementById("textoBusqueda").value;
    // window.open("https://buscador.ipn.anteater.ai/search?q="+texto,'_blank');
    var dominio = "ipn.mx"; // Reemplaza con el dominio que desees
    var consulta = "site:" + dominio + " " + texto;
    window.open("https://www.google.com/search?q=" + encodeURIComponent(consulta), '_blank');
}
    
    //Historico de Gacetas y Suplemento
    $(document).ready(function() { 
        $( "#filtro-combo select" ).change(function() {
          $("#filtro-combo").submit();
        });
    });
    // Sticky on Scroll del menú principal
    document.addEventListener("DOMContentLoaded", function(){
        window.addEventListener('scroll', function() {
            if (window.scrollY > 157) {
                if(document.getElementById('menu_sticky')) {
                    document.getElementById('menu_sticky').classList.add('fixed-top');
                }
                navbar_height = document.querySelector('.navbar').offsetHeight;
                document.body.style.paddingTop = navbar_height + 'px';
            } else {
                if(document.getElementById('menu_sticky')) {
                    document.getElementById('menu_sticky').classList.remove('fixed-top');
                    document.body.style.paddingTop = '63';
                }
            }
        });
    });
    

    // Ajustes para menu manual cuando se tienen mas elemnetos con la propiedad sticky
    document.addEventListener("DOMContentLoaded", function(){
        window.addEventListener('scroll', function() {
            if (window.scrollY > 157) {
                let altoMenuGob = 62.8,altoMenuPrincipal= 0, altoTituloUnidad=0, altoMenuManual=0;
                if(this.document.querySelector("#menu-principal")){
                    altoMenuPrincipal = this.document.querySelector("#menu-principal").offsetHeight;
                    this.document.querySelector("#menu-principal").setAttribute("style","top:" + altoMenuGob.toFixed(1)+"px");
                }
                if(this.document.querySelector("#tituloUnidad")){
                    altoTituloUnidad = this.document.querySelector("#tituloUnidad").offsetHeight;
                    let alto =altoMenuGob + altoMenuPrincipal;
                    this.document.querySelector("#tituloUnidad").setAttribute("style","top:" + alto.toFixed(1)+"px");   
                }
                if(this.document.querySelector("#menuManual")){
                    altoMenuManual = this.document.querySelector("#menuManual").offsetHeight;
                    let altoManual = altoMenuGob + altoMenuPrincipal + altoTituloUnidad;
                    this.document.querySelector("#menuManual").setAttribute("style","top:"+ altoManual.toFixed(1)+"px");   
                }
            }
        });
    });
    
    // Opciones de accesibilidad
    $(".contraste").on("click", function(a) { 
        $("body, .bg--blanco, .bg--patron-blanco, .bg--guinda, .bg--patron-guinda, .bg--gris, .bg--patron-gris, .bg--grisOscuro, .bg--grisMedio , .bg--patron-grisOscuro, .bg--grisAzulado, .oe-one-column, .oe-two-col, .dropdown-menu , .list-info ").toggleClass("bg--negro") 
    });

    $(".aumentaLetra").on("click", function(a) { $(".reduceLetra").removeClass("deshabiltar");
        a = $("html"); var b = a.css("font-size");
        16 < b.replace("px", "") ? $(".aumentaLetra").addClass("deshabiltar") : $(".aumentaLetra").removeClass("deshabiltar");
        b = parseFloat(b, 10);
        a.css("font-size", b + 2); return !1 
    });

    $(".reduceLetra").click(function() { $(".aumentaLetra").removeClass("deshabiltar"); var a = $("html"),
        b = a.css("font-size");
        16 > b.replace("px", "") ? $(".reduceLetra").addClass("deshabiltar") : $(".reduceLetra").removeClass("deshabiltar");
        b = parseFloat(b, 10);
        a.css("font-size", b - 2); return !1 
    });

    $(".resetLetra").click(function() { 
        $("html").css("font-size", "16px");
        $(".aumentaLetra").removeClass("deshabiltar");
        $(".reduceLetra").removeClass("deshabiltar") 
    });
    
    $(".resetLetra").click(function() { 
        $("html").css("font-size", "16px");
        $(".aumentaLetra").removeClass("deshabiltar");
        $(".reduceLetra").removeClass("deshabiltar") 
    });

    // Botón de Radio IPN
    var x = document.getElementById("ipnAudioRedes"); 
    function playAudio() { 
        x.play(); 
        document.getElementById("reproducirRadio").style.display = "none";
        document.getElementById("stopRadio").style.display = "block";
    } 
    function pauseAudio() { 
        x.pause(); 
        document.getElementById("stopRadio").style.display = "none";
        document.getElementById("reproducirRadio").style.display = "block";
    } 
    //  Componente titulo de unidad
    window.addEventListener('scroll', ()=>{
        let tituloUnidad = document.querySelector("#tituloUnidad");
        if(tituloUnidad != null){
            if(window.scrollY == 0){
                if(tituloUnidad.classList.contains("sticky-top")){
                    tituloUnidad.classList.remove("sticky-top");
                    tituloUnidad.classList.remove("titulo_unidad_fondo");
                }
            }
            else{
                tituloUnidad.classList.add("sticky-top");
                if(window.scrollY > 328){
                    tituloUnidad.classList.add("titulo_unidad_fondo");
                }  
            } 
        }
    });
    
    //SLIDER CENTRAL: Para agregar item del slider

    let sliderCentralItem = document.querySelectorAll(".sliderIndicators");

    if(sliderCentralItem != null){

        for(s = 0; s < sliderCentralItem.length; s++){ 

            let sliderCentralIndicators = sliderCentralItem[s].firstElementChild;

            let items = sliderCentralItem[s].firstElementChild.nextElementSibling.children.length

            for(i = 0; i < items; i++){ 
                
                let buttonIndicador = document.createElement("button");
                    buttonIndicador.setAttribute("type","button");
                    buttonIndicador.setAttribute("data-bs-target","#"+sliderCentralItem[s].id);
                    buttonIndicador.setAttribute("data-bs-slide-to",i);
                    buttonIndicador.setAttribute("aria-label","Slide " + (i+1));
                    if(i == 0){
                        buttonIndicador.setAttribute("class","active");
                        buttonIndicador.setAttribute("aria-current","true");
                    }
                sliderCentralIndicators.append(buttonIndicador);
            }
        }
    }


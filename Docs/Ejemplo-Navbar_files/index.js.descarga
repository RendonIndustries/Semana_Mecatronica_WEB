// FORMULARIO DOCTORADO
$("#frmDoctorado").submit(function(){
    console.log("Entre a la funcion");
    event.preventDefault();
    var a={
            nombre:$("#frmDoctorado #nombre").val(),
            apellidoPaterno:$("#frmDoctorado #apellidoPaterno").val(),
            apellidoMaterno:$("#frmDoctorado #apellidoMaterno").val(),
            correo:$("#frmDoctorado #correo").val(),
            domicilio:$("#frmDoctorado #domicilio").val(),
            telefonoFijo:$("#frmDoctorado #telefonoFijo").val(),
            celular:$("#frmDoctorado #celular").val(),
            nacimiento:$("#frmDoctorado #nacimiento").val(),
            edad:$("#frmDoctorado #edad").val(),
            lugar:$("#frmDoctorado #lugar").val(),
            nacionalidad:$("#frmDoctorado #nacionalidad").val(),
            optSexo:$("input:radio[name=optSexo]:checked").val(),
            estadoCivil:$("#frmDoctorado #estadoCivil").val(),
            docIdentificacion:$("#frmDoctorado #docIdentificacion").val(),
            maestria:$("#frmDoctorado #maestria").val(),
            institucionMaestria:$("#frmDoctorado #institucionMaestria").val(),
            obtencionMaestria:$("#frmDoctorado #obtencionMaestria").val(),
            especialidad:$("#frmDoctorado #especialidad").val(),
            institucionEspecialidad:$("#frmDoctorado #institucionEspecialidad").val(),
            obtencionEspecialidad:$("#frmDoctorado #obtencionEspecialidad").val(),
            licenciatura:$("#frmDoctorado #licenciatura").val(),
            institucionLicenciatura:$("#frmDoctorado #institucionLicenciatura").val(),
            obtencionLicenciatura:$("#frmDoctorado #obtencionLicenciatura").val(),
            idioma:$("#frmDoctorado #idioma").val(),
            selectOpt1:$("#frmDoctorado #selectOpt1").val(),
            selectOpt2:$("#frmDoctorado #selectOpt2").val(),
            optTiempo:$("input:radio[name=optTiempo]:checked").val(),
            optMedio:$("input:radio[name=optMedio]:checked").val(),
            destino:$("#frmDoctorado #destino").val()
        };
        $.ajax({
            type:"POST",
            url:"https://www.cpwi-buzon404.ipn.mx/Modx/doctoradoISRM/mail_v2.php",
            data:a,
            success:function(){
                $("#frmDoctorado #alertSucc").slideDown("slow",function(){
                    $("#frmDoctorado #alertSucc").removeClass("d-none");
                    setTimeout(function(){
                        $("#frmDoctorado #alertSucc").slideUp("slow");        
                        $("#frmDoctorado #alertSucc").addClass("d-none");
                        resetFrmDoctorado();
                    },2500)
                });
            },
            error:function(a,c,d){
                console.log(a, c, d);
                resetFrmDoctorado();
            }
        });
    return!1
});
function resetFrmDoctorado(){
    $("#frmDoctorado").find(".form-control").val("");
    $("#estadoCivil option[value='0']").prop("selected", true);
    $("#selectOpt1 option[value='0']").prop("selected", true);
    $("#selectOpt2 option[value='0']").prop("selected", true);
    $("input[name=optTiempo][value='Tiempo Completo']").prop('checked', true);
    $("input[name=optMedio][value='Cartel']").prop('checked', true);
    $("input[name=optSexo][value='Hombre']").prop('checked', false);
    $("input[name=optSexo][value='Mujer']").prop('checked', false);
}
// FORMULARIO QUEJAS DEFENSORIA
$("#frmDefensoria").submit(function(){
    console.log("Entre a la funcion");
    event.preventDefault();
    var a={
            destino:$("#frmDefensoria #destino").val(),
            asunto:$("#frmDefensoria #asunto").val(),
            fecha:$("#frmDefensoria #fecha").val(),
            nombre:$("#frmDefensoria #nombre").val(),
            apellidoPaterno:$("#frmDefensoria #apellidoPaterno").val(),
            apellidoMaterno:$("#frmDefensoria #apellidoMaterno").val(),
            edad:$("#frmDefensoria #edad").val(),
            email:$("#frmDefensoria #email").val(),
            numEmpleado:$("#frmDefensoria #numEmpleado").val(),
            unidad:$("#frmDefensoria #unidad").val(),
            mensaje:$("#frmDefensoria #mensaje").val()

        };
        $.ajax({
            type:"POST",
            url:"https://www.cpwi-buzon404.ipn.mx/Modx/defensoria/mail.php",
            data:a,
            success:function(){
                $("#frmDefensoria").find(".form-control").val("");
                event.preventDefault(); 
                let confirmacion = document.getElementById("mensajeConfirmacion");
            
                confirmacion.style.display = "block";
            
                // Ocultar después de 3 segundos
                setTimeout(() => {
                  confirmacion.style.display = "none";
                }, 3000);
                
            },
            error:function(a,c,d){
                console.log(a, c, d);
                $("#frmDefensoria").find(".form-control").val("");
            }
        });
    return!1
});

